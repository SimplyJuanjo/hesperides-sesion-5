# Copia este archivo como .env y pon tus claves detrás del =, sin comillas. .env no se sube a git.

# El LLM que redacta la respuesta. Con esta basta.
GROQ_API_KEY=

# Opcionales. Gemini: embeddings en la nube y LLM de reserva si Groq falla. Cohere: embeddings en la nube.
GEMINI_API_KEY=
CO_API_KEY=

# Con las dos claves de LLM se usa Groq. Para usar Gemini: LLM_PROVEEDOR=gemini
# Para otro modelo del mismo proveedor, por ejemplo: LLM_MODELO=openai/gpt-oss-20b
# LLM_PROVEEDOR=
# LLM_MODELO=
